# Copy to .env.local and fill in. Never commit real values.

# --- App (public, inlined into the JS bundle) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
EXPO_PUBLIC_AUDIUS_API_URL=https://api.audius.co/v1
EXPO_PUBLIC_AUDIUS_APP_NAME=Duskwave

# --- Server-only (Supabase Edge Functions / local scripts) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET

# --- Cloudflare R2 (seed script + r2-sign function) ---
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_BUCKET=duskwave-audio

# --- Optional: source catalog APIs ---
JAMENDO_CLIENT_ID=YOUR_JAMENDO_CLIENT_ID
